package Ch05;
import java.util.Scanner;

public class C01Basic {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		//-------------------------
		//기본 산술 연산자
		//-------------------------
		int a = 10, b = 20, c;
		System.out.println("a+b="+ (a + b));
		System.out.println("a-b="+ (a - b));
		System.out.println("a*b="+ (a * b));
		System.out.println("b/a="+ (b / a)); //나누기 - 몫
		System.out.println("a%b="+ (a % b));//나누기 - 나머지(1.짝홀수구분,2.배수구분,3.자리수제한,4.끝자리구하기)
		System.out.println("-a="+ -a);
		
		
		Scanner sc = new Scanner(System.in);
		
		System.out.println("숫자1 입력>>>>");
		int num1 = sc.nextInt();
		System.out.println("숫자2 입력>>>>");
		int num2 = sc.nextInt();
		
		System.out.printf("합 : %d" , num1+num2);
		System.out.printf("곱 : %d" , num1*num2);
		System.out.printf("나누기 : %d" , (double)num1/num2);
		
		
		sc.close();
	}

}
