package Ch07;

import java.util.Scanner;

public class C02While {

	public static void main(String[] args) {
		// 2단-9단 출력
		
		int i =2 ;
		int j =1;
		while(i<10) {
			while(j<10) {
				System.out.printf("%d * %d = %d\n",i,j,i*j);
				j++;
			}
			j =1;
			i++;
			System.out.println();
		}
		
		
		
		
		
		
		
		
	}

}
