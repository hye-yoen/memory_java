		//01HELLO WORLD 10회 출력
		//탈출용 변수 : i
		//탈출용 조건식 : i<10
		//탈출 연산식 : i++;
		int i=0;
		while(i<=10) {
			System.out.println(i + "HELLO WORLD");
			i++;
		}
		
		//02HELLO WORLD N회 출력(N ==키보드로 받은 정수값)
		int i=0;
		
		while(i<=10) {
			System.out.println(i + "HELLO WORLD");
			i++;
		}
		
		
	}

